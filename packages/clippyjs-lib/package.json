{
  "name": "clippyjs",
  "version": "1.0.0",
  "description": "Add Clippy or his friends to any website for instant nostalgia - modern TypeScript and React implementation.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./react": {
      "import": "./dist/Clippy.js",
      "require": "./dist/Clippy.js"
    }
  },
  "scripts": {
    "build": "yarn clean && yarn build:ts && yarn build:bundle",
    "build:ts": "tsc",
    "build:bundle": "rollup -c",
    "clean": "rm -rf dist",
    "prepublishOnly": "yarn build",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/**/*.{ts,tsx}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericbfriday/clippyjs.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ericbfriday/clippyjs/issues"
  },
  "homepage": "https://github.com/ericbfriday/clippyjs#readme",
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@clippyjs/types": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.4",
    "rollup-plugin-node-globals": "^1.4.0",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3"
  }
}
