{
  "name": "@clippyjs/react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react/src",
  "projectType": "library",
  "tags": [
    "type:lib",
    "scope:react",
    "platform:web"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "yarn workspace @clippyjs/react build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/packages/react"
      ],
      "options": {
        "command": "yarn workspace @clippyjs/react vitest run"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/playwright-report"
      ],
      "options": {
        "command": "yarn workspace @clippyjs/react test:integration"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "yarn workspace @clippyjs/react typecheck"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src",
        "cwd": "{projectRoot}"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/react/dist"
      }
    }
  }
}
